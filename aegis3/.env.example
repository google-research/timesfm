# Aegis3 runtime configuration
# Copy to .env (which is gitignored). Real secrets live in the OS keychain,
# not here.

AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8787

AEGIS_DB_URL=postgresql+psycopg://aegis@127.0.0.1:5432/aegis3
AEGIS_REDIS_URL=redis://127.0.0.1:6379/0

AEGIS_ARTIFACTS_DIR=~/.local/share/aegis3/artifacts
AEGIS_RUNS_DIR=~/.local/share/aegis3/runs
AEGIS_POLICY_PATH=~/.config/aegis3/policy.json

# Egress is denied by default; opt in per job at runtime.
AEGIS_DEFAULT_EGRESS=deny

# Hypothesis engine. 'rule' | 'ollama' | 'anthropic' | 'openai'
AEGIS_HYPO_BACKEND=rule
# AEGIS_OLLAMA_URL=http://127.0.0.1:11434
# AEGIS_ANTHROPIC_MODEL=claude-fable-5
